# =============================================================================
# AVM Campo Grande/MS — variáveis de ambiente
# Local: copie para .env  |  Streamlit Cloud: cole em App settings > Secrets (formato TOML: CHAVE = "valor")
# =============================================================================

# ---- Identidade da empresa (cabeçalho do PDF) -------------------------------
COMPANY_NAME="Sua Empresa de Avaliações Ltda."
COMPANY_CNPJ="00.000.000/0001-00"
COMPANY_ADDRESS="Av. Afonso Pena, 0000 — Centro, Campo Grande/MS"
COMPANY_PHONE="(67) 3000-0000"
COMPANY_EMAIL="contato@suaempresa.com.br"
# Caminho do logotipo (PNG/JPG). Se não existir, o PDF usa um monograma com as iniciais.
COMPANY_LOGO_PATH="assets/logo.png"
# Nome e registro do responsável técnico (opcional — gera linha de assinatura)
RESPONSAVEL_TECNICO=""

# ---- Coleta online (scraping) -----------------------------------------------
# Fontes ativas, separadas por vírgula: vivareal, zap, olx
SCRAPER_SOURCES="vivareal,zap,olx"
# Timeout por requisição (segundos)
SCRAPER_TIMEOUT=20
# Proxy/serviço anti-bloqueio para produção: none | zenrows | scraperapi
SCRAPER_PROVIDER="none"
# https://www.zenrows.com  (usado quando SCRAPER_PROVIDER=zenrows)
ZENROWS_API_KEY=""
# https://www.scraperapi.com  (usado quando SCRAPER_PROVIDER=scraperapi)
SCRAPERAPI_KEY=""

# ---- Cache de amostras -------------------------------------------------------
# SQLite local; no Streamlit Cloud o disco é efêmero (o cache vale enquanto o app estiver ativo)
CACHE_DB_PATH="data/cache.sqlite3"
CACHE_TTL_DAYS=7

# ---- Modo simulado (mock) ----------------------------------------------------
# true  = se TODAS as fontes falharem, usa amostras simuladas (PDF sai marcado "MODO DEMONSTRAÇÃO")
# false = recomendado em produção: exibe erro em vez de simular
AVM_ALLOW_MOCK=true
# true = ignora os portais e usa sempre o mock (testes/demonstrações)
AVM_FORCE_MOCK=false
